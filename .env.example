# Payload CMS (local)
PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URL=file:./data/payload.db

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp — canonical value lives in src/config/contact.ts
NEXT_PUBLIC_WHATSAPP_PHONE=34610429326

# Content source
# - unset locally → Payload + SQLite
# - on Vercel with file: DB (or no DB) → automatic static JSON (MVP)
# - force JSON everywhere: USE_STATIC_CONTENT=true
# - force Payload on Vercel (needs remote DATABASE_URL): USE_STATIC_CONTENT=false
# USE_STATIC_CONTENT=true
